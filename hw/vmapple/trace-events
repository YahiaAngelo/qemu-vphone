# aes.c
aes_read(uint64_t offset, uint64_t res) "offset=0x%"PRIx64" res=0x%"PRIx64
aes_cmd_key_select_builtin(uint32_t ctx, uint32_t key_id, const char *direction, const char *cipher) "[%d] Selecting builtin key %d to %scrypt with %s"
aes_cmd_key_select_new(uint32_t ctx, uint32_t key_len, const char *direction, const char *cipher) "[%d] Selecting new key size=%d to %scrypt with %s"
aes_cmd_iv(uint32_t ctx, uint32_t iv0, uint32_t iv1, uint32_t iv2, uint32_t iv3) "[%d] 0x%08x 0x%08x 0x%08x 0x%08x"
aes_cmd_data(uint32_t key, uint32_t iv, uint64_t src, uint64_t dst, uint32_t len) "[key=%d iv=%d] src=0x%"PRIx64" dst=0x%"PRIx64" len=0x%x"
aes_cmd_store_iv(uint32_t ctx, uint64_t addr, uint32_t iv0, uint32_t iv1, uint32_t iv2, uint32_t iv3) "[%d] addr=0x%"PRIx64"x -> 0x%08x 0x%08x 0x%08x 0x%08x"
aes_cmd_flag(uint32_t raise, uint32_t flag_info) "raise=%d flag_info=0x%x"
aes_fifo_process(uint32_t cmd, bool success) "cmd=%d success=%d"
aes_write(uint64_t offset, uint64_t val) "offset=0x%"PRIx64" val=0x%"PRIx64
aes_2_read(uint64_t offset, uint64_t res) "offset=0x%"PRIx64" res=0x%"PRIx64
aes_2_write(uint64_t offset, uint64_t val) "offset=0x%"PRIx64" val=0x%"PRIx64
aes_dump_data(const char *desc, const char *hex) "%s%s"

# bdif.c
bdif_read(uint64_t offset, uint32_t size, uint64_t value) "offset=0x%"PRIx64" size=0x%x value=0x%"PRIx64
bdif_write(uint64_t offset, uint32_t size, uint64_t value) "offset=0x%"PRIx64" size=0x%x value=0x%"PRIx64
bdif_vblk_read(const char *dev, uint64_t addr, uint64_t offset, uint32_t len, int r) "dev=%s addr=0x%"PRIx64" off=0x%"PRIx64" size=0x%x r=%d"
bdif_vblk_write(const char *dev, uint64_t addr, uint64_t offset, uint32_t len, int r) "dev=%s addr=0x%"PRIx64" off=0x%"PRIx64" size=0x%x r=%d"

# vpiop.c
vpiop_reg_read(const char *side, uint64_t addr, uint64_t val) "%s 0x%03" PRIx64 " -> 0x%" PRIx64
vpiop_reg_write(const char *side, uint64_t addr, uint64_t val) "%s 0x%03" PRIx64 " <- 0x%" PRIx64
vpiop_msg(const char *from, const char *to, uint64_t w0, uint64_t w1) "%s -> %s 0x%016" PRIx64 " 0x%016" PRIx64

# vusb.c
vusb_read(uint64_t addr, unsigned size, uint64_t val) "0x%04" PRIx64 " size %u -> 0x%" PRIx64
vusb_write(uint64_t addr, unsigned size, uint64_t val) "0x%04" PRIx64 " size %u <- 0x%" PRIx64
vusb_tx(uint32_t len, uint8_t code, uint8_t ep) "to host: %u bytes, code %u ep 0x%02x"
vusb_rx(uint32_t len, uint32_t plen, uint8_t ep, uint8_t type) "from host: %u bytes, payload %u ep 0x%02x type %u"

# vusb-pci.c
vusb_pci_status(uint8_t status, bool active) "status 0x%02x active=%d"
vusb_pci_features(uint64_t features) "requested features 0x%016" PRIx64
vusb_pci_iov(uint8_t queue, uint32_t out_num, uint32_t in_num, uint64_t out_len, uint64_t in_len) "queue %u iov out %u in %u out_len %" PRIu64 " in_len %" PRIu64
vusb_pci_tx(uint32_t len, uint8_t code, uint8_t ep) "to host: %u bytes code %u ep 0x%02x"
vusb_pci_rx(uint32_t len, uint8_t ep, uint8_t type, uint32_t a, uint32_t b) "from host: %u bytes ep 0x%02x type %u head %08x %08x"

# sep-storage.c
sep_storage_request(uint32_t type, uint64_t sector, int ndesc, uint8_t status) "type %u sector %" PRIu64 " descs %d status %u"
